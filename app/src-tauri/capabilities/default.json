{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Explicit desktop capabilities for DIY-Thermocam Studio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/maxritter/diy-thermocam/*" },
        { "url": "https://www.diy-thermocam.net/*" }
      ]
    },
    "notification:default"
  ]
}
