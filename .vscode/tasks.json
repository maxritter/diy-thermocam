{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Website: Dev Server (Astro)",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/website"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "astro",
          "endsPattern": "Local\\s+http"
        }
      },
      "group": "build"
    },
    {
      "label": "Website: Build & Verify Dist",
      "type": "shell",
      "command": "bun --cwd website run lint && bun --cwd website run check && bun --cwd website run build && node website/scripts/verify-dist.mjs",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "App: Frontend Dev (Vite)",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:\\s+http://localhost:1420"
        }
      }
    },
    {
      "label": "App: Tauri Dev",
      "type": "shell",
      "command": "bunx tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "isBackground": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "App: Cargo Test (Workspace)",
      "type": "shell",
      "command": "cargo test --workspace",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "App: Cargo Clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "App: Frontend Check (Biome + Typecheck + Tests)",
      "type": "shell",
      "command": "bun run lint && bun run typecheck && bun test",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "App: Real Camera E2E",
      "type": "shell",
      "command": "cargo run -p thermocam-core --example real_camera_e2e -- ${input:serialPort}",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Firmware: Compile (arduino-cli)",
      "type": "shell",
      "command": "arduino-cli compile --warnings all",
      "options": {
        "cwd": "${workspaceFolder}/firmware/3.0"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Firmware: Upload (arduino-cli)",
      "type": "shell",
      "command": "arduino-cli upload -p ${input:serialPort}",
      "options": {
        "cwd": "${workspaceFolder}/firmware/3.0"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Host Unit Tests",
      "type": "shell",
      "command": "make test",
      "options": {
        "cwd": "${workspaceFolder}/firmware/3.0/tests_host"
      },
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Firmware: UI Simulator Screenshots",
      "type": "shell",
      "command": "make screenshots",
      "options": {
        "cwd": "${workspaceFolder}/firmware/3.0/sim"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Firmware: Real Camera Pytest v2 Suite",
      "type": "shell",
      "command": "uv run --with pytest --with pyserial pytest -v test_v2_protocol.py test_v2_sd_rad.py test_v2_stream_perf.py --port ${input:serialPort}",
      "options": {
        "cwd": "${workspaceFolder}/firmware/3.0/test"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Hardware: Validate BOM",
      "type": "shell",
      "command": "python3 hardware/bom/validate_bom.py",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Hardware: Export PCB Fab Packages",
      "type": "shell",
      "command": "python3 hardware/pcb/scripts/export_fab.py --rev all",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Hardware: Verify V3 KiCad Port",
      "type": "shell",
      "command": "python3 hardware/pcb/scripts/verify_v3_port.py",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Hardware: Enclosure CAD Export (build123d)",
      "type": "shell",
      "command": "uv run --python 3.12 thermocam-case-export",
      "options": {
        "cwd": "${workspaceFolder}/hardware/enclosure/cad"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Hardware: Enclosure CAD Pytest",
      "type": "shell",
      "command": "uv run --python 3.12 pytest",
      "options": {
        "cwd": "${workspaceFolder}/hardware/enclosure/cad"
      },
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "DIY-Thermocam V3 serial port (e.g. /dev/cu.usbmodem93126801, /dev/ttyACM0, COM4)",
      "default": "/dev/cu.usbmodem93126801"
    }
  ]
}
