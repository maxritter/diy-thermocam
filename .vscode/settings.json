{
  "rust-analyzer.linkedProjects": [
    "app/Cargo.toml"
  ],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": [
    "--all-targets"
  ],
  "biome.enabled": true,
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/firmware/3.0/include",
    "${workspaceFolder}/firmware/3.0/src/core"
  ],
  "files.associations": {
    "*.ino": "cpp",
    "*.kicad_pcb": "lisp",
    "*.kicad_sch": "lisp"
  },
  "files.watcherExclude": {
    "**/app/target/**": true,
    "**/website/dist/**": true,
    "**/node_modules/**": true,
    "**/.pytest_cache/**": true
  },
  "search.exclude": {
    "**/app/target/**": true,
    "**/website/dist/**": true,
    "**/node_modules/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "app/Cargo.lock": true,
    "app/bun.lock": true,
    "website/bun.lock": true
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  }
}
