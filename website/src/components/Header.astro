---
import { NAV_LINKS, SITE } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<a class="skip" href="#main-content">Skip to content</a>
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href="/" aria-label="DIY-Thermocam home">
      <Logo size={26} />
      <span>DIY-Thermocam</span>
    </a>
    <nav class="nav" aria-label="Main">
      {NAV_LINKS.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="hdr-tools">
      <a class="icon-btn gh" href={SITE.repoUrl} aria-label="DIY-Thermocam on GitHub"><Icon name="github" /></a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch theme"><Icon name="moon" /></button>
      <a class="btn btn-primary btn-sm hdr-dl" href="/software/#download">Download</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="mnav" class="mnav" hidden aria-label="Mobile">
    {NAV_LINKS.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
    <a href="/software/#download">Download Studio and firmware</a>
    <a href={SITE.repoUrl}>GitHub</a>
  </nav>
</header>
