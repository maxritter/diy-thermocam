---
import { NAV_LINKS, SITE } from '../lib/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="tc-hdr">
  <div class="tc-hdr-inner">
    <a href="/" class="tc-brand" aria-label="DIY-Thermocam Home">
      <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M4.5 10.5V6.5C4.5 5.395 5.395 4.5 6.5 4.5H10.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M21.5 4.5H25.5C26.605 4.5 27.5 5.395 27.5 6.5V10.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M27.5 21.5V25.5C27.5 26.605 26.605 27.5 25.5 27.5H21.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10.5 27.5H6.5C5.395 27.5 4.5 26.605 4.5 25.5V21.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="16" cy="16" r="7.5" stroke="currentColor" stroke-width="1.75"/>
        <path d="M16 5.5V9.25M16 22.75V26.5M5.5 16H9.25M22.75 16H26.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="16" cy="16" r="4" fill="var(--tc-thermal)" fill-opacity="0.25"/>
        <circle cx="16" cy="16" r="2.25" fill="var(--tc-thermal)"/>
      </svg>
      <span>DIY-Thermocam</span>
    </a>

    <nav class="tc-nav" aria-label="Main navigation">
      {NAV_LINKS.map((link) => {
        const isActive = currentPath === link.href || currentPath.startsWith(link.href);
        return (
          <a href={link.href} class:list={['tc-nav-link', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="tc-hdr-actions">
      <button
        type="button"
        class="tc-theme-btn"
        id="tc-theme-toggle"
        aria-label="Toggle color theme"
        title="Toggle light/dark theme"
      >
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer" class="tc-gh-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <button
        type="button"
        class="tc-menu-btn"
        id="tc-mobile-menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="tc-mobile-nav"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="tc-mobile-nav" class="tc-mobile-nav" hidden aria-label="Mobile navigation">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class="tc-mobile-link">{link.label}</a>
    ))}
    <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer" class="tc-mobile-link">GitHub Repository</a>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('tc-theme-toggle');
    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('starlight-theme', next);
    });

    const menuBtn = document.getElementById('tc-mobile-menu-btn');
    const mobileNav = document.getElementById('tc-mobile-nav');
    menuBtn?.addEventListener('click', () => {
      const isOpen = !mobileNav?.hasAttribute('hidden');
      if (isOpen) {
        mobileNav?.setAttribute('hidden', '');
        menuBtn.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav?.removeAttribute('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>

<style>
  .tc-hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--tc-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--tc-border);
  }
  .tc-hdr-inner {
    max-width: var(--tc-container);
    height: var(--tc-nav-h);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .tc-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--tc-text);
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.03em;
    flex-shrink: 0;
  }
  .tc-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .tc-nav-link {
    padding: 6px 11px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 500;
    color: var(--tc-text-muted);
    text-decoration: none;
    transition: background 140ms var(--tc-ease), color 140ms var(--tc-ease);
  }
  .tc-nav-link:hover {
    background: var(--tc-surface-2);
    color: var(--tc-text);
  }
  .tc-nav-link.active {
    background: var(--tc-thermal-soft);
    color: var(--tc-thermal);
    font-weight: 600;
  }
  .tc-hdr-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tc-theme-btn,
  .tc-menu-btn {
    width: 34px;
    height: 34px;
    display: inline-grid;
    place-items: center;
    border-radius: 7px;
    border: 1px solid var(--tc-border);
    background: var(--tc-surface);
    color: var(--tc-text-muted);
    cursor: pointer;
  }
  .tc-theme-btn:hover,
  .tc-menu-btn:hover {
    background: var(--tc-surface-2);
    color: var(--tc-text);
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .icon-sun,
  :global(:root:not([data-theme])) .icon-sun {
    display: none;
  }
  .tc-gh-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 12px;
    border-radius: 7px;
    border: 1px solid var(--tc-border);
    background: var(--tc-surface);
    color: var(--tc-text);
    font-size: 13.5px;
    font-weight: 550;
    text-decoration: none;
  }
  .tc-gh-btn:hover {
    border-color: var(--tc-border-strong);
    background: var(--tc-surface-2);
  }
  .tc-menu-btn {
    display: none;
  }
  .tc-mobile-nav {
    border-top: 1px solid var(--tc-border);
    background: var(--tc-bg);
    padding: 12px 24px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tc-mobile-nav[hidden] {
    display: none;
  }
  .tc-mobile-link {
    padding: 10px 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--tc-text);
    text-decoration: none;
    border-bottom: 1px solid var(--tc-border);
  }
  @media (max-width: 820px) {
    .tc-nav,
    .tc-gh-btn {
      display: none;
    }
    .tc-menu-btn {
      display: inline-grid;
    }
  }
</style>
