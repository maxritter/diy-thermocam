---
/* Real Studio screenshots, taken from Studio's interface with the demo camera playing the sample captures. */
import AppShot from './AppShot.astro';

const tabs = [
  { id: 'live', label: 'Live', shot: 'live' as const, alt: 'Studio Live view: a circuit board under load in Inferno, a box on the hot chip and a spot on the regulator, with the palette panel beside it', cap: 'The live image, with the hottest spot marked.' },
  { id: 'measure', label: 'Measure', shot: 'measure' as const, alt: 'Studio measuring a breaker panel: a box on the hot breaker, a line across the row, and charts of the readings over time and along the line', cap: 'Boxes, spots and lines, charted over time.' },
  { id: 'editor', label: 'Captures', shot: 'editor' as const, alt: 'A saved capture of a solar panel opened in Studio in Rainbow, a box on the hot cell and its readings in the Measure tab', cap: 'Measure a saved capture again.' },
  { id: 'library', label: 'Library', shot: 'library' as const, alt: 'Studio’s Captures library in grid view with eight thermal pictures, each showing its hottest temperature', cap: 'Captures from computer and camera, in one place.' },
  { id: 'palettes', label: 'Palettes', shot: 'palettes' as const, alt: 'A house front in winter in Ironblack, with Studio’s palette grid open beside it', cap: 'The camera’s 19 palettes and five more.' },
];
---

<div class="studio-grid">
  <div class="tabs" role="tablist" aria-label="Studio screens">
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`t-${t.id}`} aria-controls={`p-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
    ))}
  </div>
  <div>
    {tabs.map((t, i) => (
      <div id={`p-${t.id}`} role="tabpanel" aria-labelledby={`t-${t.id}`} hidden={i !== 0}>
        <div class="window"><AppShot name={t.shot} alt={t.alt} caption={t.cap} eager={i === 0} /></div>
        <p class="panel-cap">{t.cap}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .studio-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--border); width: max-content; max-width: 100%; }
  .tabs [role='tab'] { height: 40px; padding: 0 16px; border: 0; border-radius: 0; background: none; color: var(--muted); font: 500 12px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: background-color 140ms ease, color 140ms ease; }
  .tabs [role='tab'] + [role='tab'] { border-left: 1px solid var(--border); }
  .tabs [role='tab']:hover { color: var(--text); background: var(--bg-2); }
  .tabs [role='tab'][aria-selected='true'] { background: var(--hot); color: var(--on-accent); }
  .window { max-width: 100%; }
  .panel-cap { max-width: 920px; margin: 14px 0 0; color: var(--muted); font-size: 14px; }
  @media (prefers-reduced-motion: reduce) { .tabs [role='tab'] { transition: none; } }
  @media (max-width: 600px) {
    .tabs { width: 100%; }
    .tabs [role='tab'] { flex: 1 1 auto; padding: 0 6px; height: 44px; font-size: 10.5px; letter-spacing: 0.04em; white-space: nowrap; }
  }
</style>
