---
/* "What you need" for the build guide: one card per part with its picture, what it is and where it comes from.
   Shop links come from src/data/parts.ts, so prices and links live in one place. */
import { MAKERS, PARTS } from '../data/parts';
import Icon from './Icon.astro';

const shop = (id: string, i = 0) => {
  const o = PARTS.find((p) => p.id === id)?.shops[i];
  return o ? { name: o.s, href: o.u.us } : null;
};

interface Need {
  name: string;
  detail: string;
  img?: string;
  fit?: 'cover' | 'contain';
  from: { name: string; href: string }[];
}

const needs: Need[] = [
  { name: 'V4 main board', detail: 'Assembled by the fab, plus bare FR4 battery floor and lid', img: '/images/v4/pcb-modules.png', fit: 'contain',
    from: [{ name: 'JLCPCB', href: 'https://jlcpcb.com/' }, { name: 'Seeed', href: 'https://www.seeedstudio.com/fusion_pcb.html' }, { name: 'PCBWay', href: 'https://www.pcbway.com/pcb-assembly.html' }] },
  { name: 'Shell, printed or laser-cut', detail: 'Printed, or cut from 3 mm acrylic', img: '/images/v4/view-kit.jpg',
    from: MAKERS.filter((m) => !m.own && ['jlc3dp', 'craftcloud', 'formulor', 'sendcutsend'].includes(m.id)).map((m) => ({ name: m.name, href: m.url })) },
  { name: 'Teensy 4.1 with headers', detail: 'With pins soldered', img: '/images/parts/s-teensy.jpg', fit: 'contain',
    from: [shop('teensy'), shop('teensy', 1)].filter(Boolean) as Need['from'] },
  { name: 'FLIR Lepton 3.5', detail: '160 × 120, 57°; or the 3.1R for 95°', img: '/images/parts/s-lepton35.jpg',
    from: [shop('lepton35'), shop('lepton35', 1)].filter(Boolean) as Need['from'] },
  { name: 'Lepton Breakout V2.0 + RA header', detail: 'FLIR 250-0577-00 (Rev R200) + Sullins PPPC102LJBN-RC (3.15 mm tails)', img: '/images/parts/s-breakout.jpg', fit: 'contain',
    from: [
      { name: 'Breakout (DigiKey)', href: shop('breakout')!.href },
      { name: 'Breakout (Mouser)', href: shop('breakout', 1)!.href },
      { name: 'RA header (DigiKey)', href: shop('adapter')!.href },
    ] },
  { name: '3.2" touch display', detail: 'ER-TFTM032-3, 4-wire SPI, 5 V', img: '/images/parts/s-display.jpg',
    from: [shop('display')].filter(Boolean) as Need['from'] },
  { name: 'LiPo, Adafruit 258, 1200 mAh', detail: 'Protected, 5 × 34 × 62 mm, JST-PH', img: '/images/parts/s-lipo.jpg',
    from: [shop('lipo'), shop('lipo', 2)].filter(Boolean) as Need['from'] },
  { name: 'Standoffs, screws and nuts', detail: 'M2.5 standoffs and screws, M2 screws for Breakout V2.0', img: '/images/parts/s-csk.jpg',
    from: [{ name: 'ettinger.de', href: 'https://www.ettinger.de/' }] },
  { name: '1/4"-20 nut, microSD and USB-C', detail: 'Stainless tripod nut at DigiKey; 16–32 GB card; data cable', img: '/images/parts/s-microsd.jpg',
    from: [shop('nut1420'), shop('cable')].filter(Boolean) as Need['from'] },
];

const tools = [
  { icon: 'screwdriver' as const, name: 'PH1 and 2 mm flat screwdrivers, 4 and 5 mm nut drivers (the 5 mm one at most 7.5 mm across), fine tweezers, medium-strength threadlocker' },
  { icon: 'usb' as const, name: 'USB-C cable and a computer' },
];
---

<div class="needs not-content">
  {needs.map((n) => (
    <div class="need">
      <span class:list={['pic', n.fit === 'contain' && 'fit']}>{n.img ? <img src={n.img} alt="" loading="lazy" /> : null}</span>
      <div class="body">
        <b>{n.name}</b>
        <span class="d">{n.detail}</span>
        <span class="from">
          {n.from.map((f) => <a href={f.href}>{f.name}</a>)}
        </span>
      </div>
    </div>
  ))}
</div>

<div class="tools not-content">
  <b>Tools</b>
  {tools.map((t) => <span class="tool"><Icon name={t.icon} />{t.name}</span>)}
</div>

<div class="go not-content">
  <a class="btn btn-ghost btn-sm" href="/docs/partlist/">Open the parts list</a>
  <span>Prices, links and fab files.</span>
</div>

<style>
  .needs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
  .need { display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); }
  .pic { display: block; aspect-ratio: 4 / 3; background: var(--cad); border-bottom: 1px solid var(--border); }
  .pic img { width: 100%; height: 100%; object-fit: cover; border: 0; border-radius: 0; }
  .pic.fit { background: #fff; }
  .pic.fit img { object-fit: contain; padding: 10px; }
  .body { display: grid; align-content: start; gap: 3px; padding: 12px 14px 14px; }
  .body b { font-size: 14.5px; font-weight: 600; color: var(--text); line-height: 1.35; }
  .d { font-size: 13px; color: var(--muted); line-height: 1.45; }
  .from { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .from a { font-size: 12.5px; font-weight: 500; text-decoration: none; color: var(--text); padding: 3px 9px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2); }
  .from a:hover { border-color: var(--border-strong); color: var(--accent); }
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 16px; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-2); font-size: 14px; color: var(--muted); }
  .tools b { color: var(--text); font-weight: 600; }
  .tool { display: inline-flex; align-items: center; gap: 8px; }
  .tool :global(svg) { width: 18px; height: 18px; display: block; color: var(--dim); }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 16px; font-size: 14px; color: var(--muted); }
  @media (max-width: 1100px) { .needs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .needs { grid-template-columns: 1fr; } }
</style>
