---
/* One wording for V4's status, used wherever the V4 board or shell appears. */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{
  compact ? (
    <div class="v4-pill not-content" role="note">
      <span class="dot" aria-hidden="true" />
      <span>
        <b>V4 is experimental.</b> Not yet tested on a real camera.
      </span>
    </div>
  ) : (
    <aside class="v4-note not-content" aria-label="V4 status">
      <span class="dot" aria-hidden="true" />
      <div>
        <b>V4 is experimental and still in development.</b>
        <div class="body">
          The V4 board and shell haven't been built and tested on a real camera yet. You're welcome to try them, but there's
          no guarantee they work. Already have a V3? It can <a href="/software/#download">update its firmware and use Studio</a> today.
        </div>
      </div>
    </aside>
  )
}

<style>
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #f0a020; box-shadow: 0 0 0 3px var(--amber-soft); flex: none; }
  .v4-pill { display: flex; width: fit-content; max-width: 100%; align-items: center; gap: 10px; margin: 0 0 22px; padding: 6px 12px 6px 10px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-2); color: var(--muted); font-size: 13.5px; line-height: 1.4; }
  .v4-pill b { color: var(--text); font-weight: 600; }
  .v4-note { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border: 1px solid var(--border); border-radius: 10px; background: var(--amber-soft); font-size: 14.5px; color: var(--muted); }
  .v4-note .dot { margin-top: 7px; }
  .v4-note b { color: var(--text); font-weight: 600; }
  .v4-note .body { margin: 4px 0 0; }
  @media (max-width: 600px) {
    .v4-pill { border-radius: 10px; align-items: flex-start; }
    .v4-pill .dot { margin-top: 5px; }
  }
</style>
