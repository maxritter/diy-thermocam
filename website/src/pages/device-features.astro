---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildBreadcrumbs } from '../lib/site';

const capabilities = [
  'Teensy 4.1 ARM Cortex-M7 running at 450 MHz default (600 MHz capable)',
  'Native 8.77 fps FLIR Lepton push streaming (export-compliant < 9 Hz)',
  '19 on-device color palettes plus hot and cold threshold highlights',
  '3.2-inch 320×240 TFT LCD with resistive touchscreen',
  '14-bit radiometric .DAT images, continuous video, and interval time-lapse',
  'Removable microSDHC / microSDXC storage (FAT32 and exFAT)',
  'Protected 2000 mAh 3.7 V LiPo battery for 4–6 hours of field use',
  'Open-source C++17 firmware compiled with arduino-cli and Teensy core 1.62.0',
  'Cross-platform Tauri v2 Desktop Studio for macOS, Windows, and Linux',
  'Byte-exact .DAT compatibility across V1, V2, V3, and V4 captures',
  'Binary USB Protocol v2 with 0.26 ms command latency and 9.20 MB/s SD reads',
];

const comparison = [
  { feature: 'Thermal resolution', tc: '80×60 (Lepton 2.5) or 160×120 (Lepton 3.1R / 3.5)', flir: '160×120' },
  { feature: 'Thermal sensitivity (NETD)', tc: '< 0.05 °C (50 mK)', flir: '< 0.06 °C (60 mK)' },
  { feature: 'Temperature range', tc: '-10 °C to +140 °C (High Gain) or +450 °C (Low Gain)', flir: '-20 °C to +250 °C' },
  { feature: 'Field of view (FOV)', tc: '57° HFOV / 71° DFOV (3.5) or 95° HFOV / 119° DFOV (3.1R)', flir: '45° × 34°' },
  { feature: 'Display', tc: '3.2" 320×240 TFT, touchscreen', flir: '3.0" 320×240, non-touch' },
  { feature: 'Temperature spots', tc: 'Up to 96 spots on-device; unlimited ROIs in Desktop Studio', flir: 'Center spot only' },
  { feature: 'Color schemes', tc: '19 on-device + scientific LUTs in Desktop Studio', flir: 'Rainbow, Iron, Grayscale' },
  { feature: 'Recording modes', tc: 'Still images, continuous video, and time-lapse', flir: 'Still images only' },
  { feature: 'Storage', tc: 'Removable microSD card (FAT32 / exFAT)', flir: 'Internal (~500 image sets)' },
  { feature: 'File formats', tc: 'Open 14-bit .DAT, BMP, PNG, 16-bit TIFF, CSV, H.264 MP4', flir: 'Proprietary radiometric JPEG' },
  { feature: 'Weight', tc: '~255 g', flir: '575 g' },
  { feature: 'Hardware & source code', tc: 'Open-source (GPL-3.0)', flir: 'Closed proprietary' },
];

const jsonLd = buildBreadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Device Features', path: '/device-features/' },
]);
---

<MarketingLayout
  title="Device Features"
  description="Hardware and firmware specifications for DIY-Thermocam V3 and V4, compared side-by-side with the FLIR E6."
  canonicalPath="/device-features/"
  jsonLd={jsonLd}
>
  <section class="page-wrap">
    <header class="page-head">
      <h1>Device features and specifications</h1>
      <p>
        Radiometric long-wave infrared imaging on open hardware, with full KiCad, firmware, and
        protocol source code.
      </p>
    </header>

    <section class="spec-block">
      <h2>Core capabilities</h2>
      <ul class="cap-grid">
        {capabilities.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="spec-block">
      <h2>DIY-Thermocam vs. FLIR E6</h2>
      <div class="table-wrap">
        <table class="spec-table tabular">
          <thead>
            <tr>
              <th>Specification</th>
              <th>DIY-Thermocam</th>
              <th>FLIR E6</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <td class="label-col">{row.feature}</td>
                <td class="tc-col">{row.tc}</td>
                <td>{row.flir}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="next-links">
      <a href="/docs/partlist/" class="btn-primary">Bill of Materials</a>
      <a href="/building-instructions/" class="btn-secondary">Building Instructions</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .page-wrap {
    max-width: var(--tc-container);
    margin: 0 auto;
    padding: 56px 28px 24px;
  }
  .page-head {
    max-width: 64ch;
    margin-bottom: 48px;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 650;
  }
  .page-head p {
    margin: 12px 0 0;
    font-size: 1.05rem;
    color: var(--tc-text-muted);
  }
  .spec-block {
    padding-top: 32px;
    border-top: 1px solid var(--tc-border);
    margin-bottom: 52px;
  }
  .spec-block h2 {
    margin: 0 0 20px;
    font-size: 1.35rem;
    font-weight: 650;
  }
  .cap-grid {
    margin: 0;
    padding-left: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 36px;
    color: var(--tc-text-muted);
    font-size: 15px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .spec-table th {
    text-align: left;
    padding: 12px 14px 12px 0;
    border-bottom: 1px solid var(--tc-border-strong);
    font-weight: 650;
    color: var(--tc-text);
  }
  .spec-table td {
    padding: 13px 14px 13px 0;
    border-bottom: 1px solid var(--tc-border);
    color: var(--tc-text-muted);
    vertical-align: top;
  }
  .label-col {
    color: var(--tc-text) !important;
    font-weight: 550;
  }
  .tc-col {
    color: var(--tc-text) !important;
  }
  .next-links {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--tc-thermal);
    color: var(--tc-text-on-thermal);
  }
  .btn-secondary {
    border: 1px solid var(--tc-border-strong);
    color: var(--tc-text);
    background: transparent;
  }
  .btn-secondary:hover {
    background: var(--tc-surface-2);
  }
  @media (max-width: 780px) {
    .cap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
