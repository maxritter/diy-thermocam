---
import Icon from '../components/Icon.astro';
import V4Status from '../components/V4Status.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildBreadcrumbs } from '../lib/site';

const specs = [
  ['lens', 'Sensor', 'FLIR Lepton 3.5, or 3.1R for a wide view'],
  ['grid', 'Resolution', '160 × 120 px, radiometric'],
  ['camera', 'Field of view', '57° (Lepton 3.5) or 95° (Lepton 3.1R)'],
  ['thermometer', 'Range', '−10 to 140 °C (high gain), up to 450 °C (low gain)'],
  ['ruler', 'Sensitivity', 'Below 50 mK'],
  ['layers', 'Frame rate', '8.7 fps'],
  ['display', 'Display', '3.2", 320 × 240, resistive touch'],
  ['sd', 'Storage', 'microSD, FAT32 or exFAT'],
  ['battery', 'Battery', '1200 mAh LiPo (or 2000 mAh), charges over USB-C'],
  ['chip', 'Processor', 'Teensy 4.1, ARM Cortex-M7 at 450 MHz'],
  ['file', 'Files', '14-bit radiometric .DAT, plus BMP from the camera'],
  ['open', 'Licence', 'GPL-3.0: board, shell, firmware and Studio'],
] as const;

const screens = [
  { src: '/images/firmware/main-menu-dark.png', cap: 'Main menu' },
  { src: '/images/firmware/palette-picker.png', cap: 'Palette picker, 19 palettes' },
  { src: '/images/firmware/overlays-grid-dark.png', cap: 'Overlays: spots, scale, isotherm' },
  { src: '/images/firmware/gallery-viewer.png', cap: 'Gallery of saved captures' },
  { src: '/images/firmware/status-screen.png', cap: 'Status: frame rate, battery, SD card' },
  { src: '/images/firmware/main-menu-page2-dark.png', cap: 'Second menu page' },
];

const comparison = [
  ['Thermal resolution', '160 × 120', '160 × 120'],
  ['Sensitivity', 'Below 50 mK', 'Below 60 mK'],
  ['Range', '−10 to 450 °C', '−20 to 250 °C'],
  ['Display', '3.2" touch', '3.0", no touch'],
  ['Temperature spots', 'Up to 96 on the camera, any number in Studio', 'Centre spot'],
  ['Recording', 'Stills, video, time-lapse', 'Stills'],
  ['Storage', 'Removable microSD', 'Internal'],
  ['Files', 'Open .DAT, PNG, TIFF, CSV, MP4', 'Radiometric JPEG'],
  ['Source', 'Open, GPL-3.0', 'Closed'],
];

const jsonLd = buildBreadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Camera', path: '/device-features/' },
]);
---

<MarketingLayout
  title="Camera"
  description="DIY-Thermocam specifications: FLIR Lepton 3.5, 160 × 120 radiometric, −10 to 450 °C, 3.2-inch touch display, microSD and USB-C, compared with the FLIR E6."
  canonicalPath="/device-features/"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="wrap cam-head">
      <div>
        <V4Status compact />
        <h1>The camera</h1>
        <p>A radiometric thermal camera you can hold, open and change. Every pixel keeps its temperature, on the camera and in Studio.</p>
      </div>
      <figure class="cam-shot"><img src="/images/v4/hero-back.jpg" alt="DIY-Thermocam V4 from the back, with the lens cap over the Lepton" width="1600" height="1066" /></figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="big">Specifications</h2></div>
      <dl class="specs">
        {specs.map(([ic, k, v]) => (
          <div><Icon name={ic} class="sic" /><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">On the camera</h2>
        <p>The touch menu, drawn by the firmware's simulator. Real captures are in the <a href="/thermal-images/">gallery</a>.</p>
      </div>
      <div class="screens">
        {screens.map((s) => (
          <figure><img src={s.src} alt={s.cap} width="640" height="480" loading="lazy" /><figcaption>{s.cap}</figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="big">Next to a FLIR E6</h2></div>
      <div class="tablewrap">
        <table class="cmp">
          <thead><tr><th scope="col"></th><th scope="col">DIY-Thermocam</th><th scope="col">FLIR E6</th></tr></thead>
          <tbody>
            {comparison.map(([k, a, b]) => (
              <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .cam-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .cam-shot { margin: 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-window); background: #c8ccd1; }
  .cam-shot img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .specs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--border); }
  .specs > div { display: grid; grid-template-columns: 36px minmax(0, 1fr); align-content: start; column-gap: 12px; padding: 18px 20px 18px 0; border-bottom: 1px solid var(--border); }
  .specs :global(.sic) { grid-row: span 2; width: 36px; height: 36px; display: grid; place-items: center; border-radius: var(--radius); background: var(--surface-2); color: var(--muted); }
  .specs :global(.sic svg) { width: 19px; height: 19px; display: block; }
  .specs dt { font-size: 13px; color: var(--dim); }
  .specs dd { margin: 4px 0 0; font-size: 15px; font-weight: 500; }
  .screens { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .screens figure { margin: 0; }
  .screens img { width: 100%; border-radius: var(--radius-lg); border: 1px solid var(--border); background: #000; }
  .screens figcaption { margin-top: 8px; font-size: 14px; color: var(--muted); }
  .tablewrap { overflow-x: auto; }
  .cmp { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 560px; table-layout: fixed; }
  .cmp th, .cmp td { text-align: left; padding: 12px 16px 12px 0; border-bottom: 1px solid var(--border); vertical-align: top; }
  .cmp thead th { font-size: 13px; color: var(--dim); font-weight: 500; }
  .cmp tbody th { font-weight: 500; color: var(--muted); }
  .cmp thead th:first-child { width: 28%; }
  .cmp td:nth-child(2) { font-weight: 500; }
  @media (max-width: 1000px) {
    .cam-head { grid-template-columns: 1fr; gap: 32px; }
    .specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .screens { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .specs, .screens { grid-template-columns: 1fr; }
  }
</style>
