---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildBreadcrumbs } from '../lib/site';

const capabilities = [
  'ARM Cortex-M7 processor (Teensy 4.1, 450 MHz default for low enclosure heat; 600 MHz capable)',
  'Up to 8.78 fps native FLIR Lepton frame rate (US export compliant < 9 Hz)',
  '19 built-in color schemes including Rainbow, Ironblack, Grayscale, Lava, Medical, and Hot/Cold alerts',
  '3.2-inch 320×240 TFT LCD with resistive touchscreen and wide viewing angles',
  'Radiometric 14-bit .DAT captures plus 640×480 preview bitmaps, continuous video, and interval time-lapse',
  'microSDHC / microSDXC storage (FAT32 and exFAT on firmware 3.1+) accessible over USB',
  'Protected 2000 mAh 3.7 V LiPo battery delivering 4–6 hours of field operation',
  'Open-source C++17 firmware compiled cleanly with arduino-cli and Teensy core 1.62.0',
  'Cross-platform Tauri v2 Desktop App (macOS, Windows, Linux) with WebGL2 live view, ROI emissivity, H.264 MP4, and built-in HalfKay firmware updates',
  'Full .DAT compatibility with legacy V1/V2/V3 captures and ThermoVision by Joe-C',
  'Binary USB Protocol v2 (480 Mbit/s USB HS CDC ACM) for concurrent streaming, live settings, SD browsing, and hardware button triggers',
];

const comparison = [
  { feature: 'Thermal resolution', tc: '80×60 (Lepton 2.5) or 160×120 (Lepton 3.1R / 3.5)', flir: '160×120' },
  { feature: 'Thermal sensitivity (NETD)', tc: '< 0.05 °C (50 mK)', flir: '< 0.06 °C (60 mK)' },
  { feature: 'Temperature range', tc: '-10 °C to +140 °C (High Gain) or -10 °C to +450 °C (Low Gain)', flir: '-20 °C to +250 °C' },
  { feature: 'Field of view (FOV)', tc: '57° HFOV, 71° diagonal (Lepton 3.5)', flir: '45° × 34°' },
  { feature: 'Display', tc: '3.2" 320×240 TFT, resistive touchscreen', flir: '3.0" 320×240, non-touch' },
  { feature: 'Temperature points', tc: 'Up to 96 custom spots on-device; unlimited ROIs in Desktop App', flir: 'Center spot only' },
  { feature: 'Color schemes', tc: '19 on-device + Inferno/Viridis/Magma/Plasma & custom LUTs in app', flir: 'Rainbow, Iron, Grayscale' },
  { feature: 'Recording modes', tc: 'Still images, continuous video, and interval time-lapse', flir: 'Still images only' },
  { feature: 'Storage capacity', tc: 'Removable microSD card (FAT32 / exFAT)', flir: 'Internal (~500 image sets)' },
  { feature: 'File formats', tc: 'Open 14-bit radiometric .DAT + BMP / PNG / 16-bit TIFF / CSV / MP4', flir: 'Proprietary radiometric JPEG' },
  { feature: 'Weight', tc: '~255 g', flir: '575 g' },
  { feature: 'Source code & hardware', tc: '100% open-source (GPL-3.0)', flir: 'Closed proprietary' },
];

const jsonLd = buildBreadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Device Features', path: '/device-features/' },
]);
---

<MarketingLayout
  title="Device Features"
  description="Complete hardware and firmware specifications for DIY-Thermocam V3 and V4, including side-by-side comparison with the FLIR E6."
  canonicalPath="/device-features/"
  jsonLd={jsonLd}
>
  <section class="page-wrap">
    <header class="page-head">
      <h1>Device features &amp; specifications</h1>
      <p>
        DIY-Thermocam delivers radiometric long-wave infrared imaging on open hardware at a fraction of commercial camera pricing, with complete firmware and protocol source code.
      </p>
    </header>

    <div class="feature-panel">
      <h2>Core capabilities</h2>
      <ul class="cap-grid">
        {capabilities.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="compare-block">
      <h2>DIY-Thermocam V3 vs. FLIR E6</h2>
      <div class="table-wrap">
        <table class="spec-table tabular">
          <thead>
            <tr>
              <th>Specification</th>
              <th>DIY-Thermocam V3</th>
              <th>FLIR E6</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <td><strong>{row.feature}</strong></td>
                <td class="highlight-col">{row.tc}</td>
                <td>{row.flir}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="next-links">
      <a href="/docs/partlist/" class="btn-primary">Inspect Bill of Materials</a>
      <a href="/building-instructions/" class="btn-secondary">Read Building Instructions</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .page-wrap {
    max-width: var(--tc-container);
    margin: 0 auto;
    padding: 48px 24px 20px;
  }
  .page-head {
    max-width: 68ch;
    margin-bottom: 36px;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 650;
  }
  .page-head p {
    margin: 12px 0 0;
    font-size: 1.05rem;
    color: var(--tc-text-muted);
  }
  .feature-panel {
    padding: 28px;
    border: 1px solid var(--tc-border);
    border-radius: 12px;
    background: var(--tc-bg-sunken);
    margin-bottom: 44px;
  }
  .feature-panel h2,
  .compare-block h2 {
    margin: 0 0 18px;
    font-size: 1.45rem;
    font-weight: 650;
  }
  .cap-grid {
    margin: 0;
    padding-left: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 28px;
    color: var(--tc-text-muted);
    font-size: 14.5px;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--tc-border);
    border-radius: 12px;
    background: var(--tc-surface);
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .spec-table th {
    text-align: left;
    padding: 13px 16px;
    background: var(--tc-bg-sunken);
    border-bottom: 1px solid var(--tc-border);
    font-weight: 650;
  }
  .spec-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--tc-border);
    color: var(--tc-text-muted);
    vertical-align: top;
  }
  .spec-table tr:last-child td {
    border-bottom: 0;
  }
  .spec-table td strong {
    color: var(--tc-text);
  }
  .highlight-col {
    color: var(--tc-text) !important;
    background: var(--tc-thermal-soft);
  }
  .next-links {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--tc-thermal);
    color: var(--tc-text-on-thermal);
  }
  .btn-secondary {
    border: 1px solid var(--tc-border-strong);
    color: var(--tc-text);
    background: var(--tc-surface);
  }
  @media (max-width: 780px) {
    .cap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
