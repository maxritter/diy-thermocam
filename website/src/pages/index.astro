---
import DownloadList from '../components/DownloadList.astro';
import Icon from '../components/Icon.astro';
import StudioTabs from '../components/StudioTabs.astro';
import V4Status from '../components/V4Status.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { EXAMPLE_H, EXAMPLE_W, EXAMPLES } from '../data/examples';
import { DOWNLOADS, SITE } from '../lib/site';

const views = [
  { id: 'front', label: 'Front', src: '/images/v4/view-front.jpg', h: 1066, alt: 'DIY-Thermocam V4 in its printed shell, the 3.2-inch display showing a live thermal image with spot temperatures' },
  { id: 'back', label: 'Back', src: '/images/v4/view-back.jpg', h: 1066, alt: 'The back of the camera with the lens cap open over the FLIR Lepton' },
  { id: 'inside', label: 'Inside', src: '/images/v4/view-inside.jpg', h: 1066, alt: 'A cut through the camera: display, board, Teensy and battery stacked on standoffs' },
  { id: 'kit', label: 'Kit', src: '/images/v4/view-kit.jpg', h: 1066, alt: 'Every part of the kit laid out: shell, display, board, modules, battery and screws' },
  { id: 'acrylic', label: 'Acrylic', src: '/images/v4/view-acrylic.jpg', h: 1066, alt: 'The laser-cut acrylic case' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.tagline,
  },
];

---

<MarketingLayout
  title={SITE.name}
  description="Build a handheld radiometric thermal camera with a FLIR Lepton 3.5 and a Teensy 4.1. Assembled board, printed shell, and Studio for macOS, Windows and Linux."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section id="camera" class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <V4Status compact />
          <h1>Build your own <span class="hot">thermal camera</span></h1>
          <p class="lead">
            A handheld radiometric camera with a FLIR Lepton 3.5 and a Teensy 4.1. The board arrives fully
            assembled: plug in four modules and close the case with eight screws. No soldering.
          </p>
          <div class="cta">
            <a class="btn btn-primary" data-os-download href="/software/#download"><Icon name="download" /><span>Download Studio</span></a>
            <a class="btn btn-ghost" href="/docs/partlist/"><Icon name="list" /><span>See the parts list</span></a>
          </div>
          <div class="hero-dl" role="group" aria-label="Studio and firmware downloads">
            <span class="dl-label">Studio</span>
            <div class="dl-chips">
              {DOWNLOADS.map((d) => (
                <a class="dl-chip" href={d.href} title={d.detail} aria-label={d.label}><Icon name={d.icon} class="chip-ic" /><span>{d.name}</span></a>
              ))}
            </div>
            <span class="dl-label">Firmware</span>
            <div class="dl-chips">
              <a class="dl-chip" href={SITE.firmwareUrl}><Icon name="chip" class="chip-ic" /><span>V3 &amp; V4 · latest release</span><Icon name="arrowUpRight" class="chip-ext" /></a>
            </div>
          </div>
        </div>
        <div class="hero-views">
          <figure class="hero-shot">
            {views.map((v, i) => (
              <img id={`v-${v.id}`} role="tabpanel" aria-labelledby={`vt-${v.id}`} src={v.src} alt={v.alt} width="1600" height={v.h} hidden={i !== 0} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
          </figure>
          <div class="thumbs" role="tablist" aria-label="Camera views">
            {views.map((v, i) => (
              <button type="button" role="tab" class="thumb" id={`vt-${v.id}`} aria-controls={`v-${v.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                <span class="thumb-img"><img src={v.src.replace('.jpg', '-thumb.jpg')} alt="" width="360" height="240" decoding="async" /></span>
                <span class="thumb-label">{v.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <dl class="specs">
        <div class="spec"><dt><Icon name="sensor" class="spec-ic" />Sensor</dt><dd>FLIR Lepton 3.5</dd></div>
        <div class="spec"><dt><Icon name="grid" class="spec-ic" />Resolution</dt><dd class="num">160 × 120 px</dd></div>
        <div class="spec"><dt><Icon name="thermometer" class="spec-ic" />Range</dt><dd class="num">−10 to 450 °C</dd></div>
        <div class="spec"><dt><Icon name="battery" class="spec-ic" />Battery</dt><dd class="num">2000 mAh, USB-C</dd></div>
        <div class="spec"><dt><Icon name="award" class="spec-ic" />Licence</dt><dd>GPL-3.0</dd></div>
      </dl>
    </div>
  </section>

  <section id="build" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">Four steps from parts to pictures</h2>
        <p>
          You need a PH1 and a 2 mm flat screwdriver, tweezers and a USB-C cable. The
          parts list sorts everything else into one order per shop, and says who can print or cut the shell.
        </p>
      </div>
      <div class="track-wrap">
        <div class="track-rail ironbow" aria-hidden="true"></div>
        <ol class="track">
          <li class="step">
            <div class="disc">1</div>
            <h3>Order the parts</h3>
            <p>The assembled board from a fab, the electronics from DigiKey or Mouser.</p>
            <figure class="photo"><img src="/images/v4/exploded.jpg" alt="Exploded render of every part: front shell, display, board with modules, battery, back shell" width="1333" height="1600" loading="lazy" /></figure>
          </li>
          <li class="step">
            <div class="disc">2</div>
            <h3>Plug in the modules</h3>
            <p>Push the Teensy and the Lepton into their sockets.</p>
            <figure class="line"><img src="/images/v4/steps/shell-03.jpg" alt="Line drawing: the Lepton on its breakout in orange, lowered onto its screws on the board" width="1118" height="1000" loading="lazy" /></figure>
          </li>
          <li class="step">
            <div class="disc">3</div>
            <h3>Close the shell</h3>
            <p>Stack board, battery and display on standoffs, then close the shell.</p>
            <figure class="line"><img src="/images/v4/steps/shell-11.jpg" alt="Line drawing: the front shell and its four screws in orange" width="1118" height="1000" loading="lazy" /></figure>
          </li>
          <li class="step">
            <div class="disc">4</div>
            <h3>Connect Studio</h3>
            <p>Studio installs the firmware over USB-C and shows the live image.</p>
            <figure class="dark"><img src="/images/examples/pcb.jpg" alt="A Studio export of a circuit board under load, with the hottest point marked" width="1470" height="1024" loading="lazy" /></figure>
          </li>
        </ol>
      </div>
      <div class="after-track">
        <a class="btn btn-ghost" href="/building-instructions/">Open the build guide</a>
        <a href="/docs/partlist/">See the parts list</a>
      </div>
    </div>
  </section>

  <section id="studio" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">Studio, the desktop app</h2>
        <p>Connect the camera over USB to see the live image, measure any point and save radiometric captures.</p>
      </div>
      <StudioTabs />

      <div id="download" class="dl">
        <div>
          <h3>Download Studio and firmware</h3>
          <p>Free and open source. Studio installs the firmware over USB-C, so you don't need Teensy Loader. V3 cameras run the same firmware and Studio today.</p>
        </div>
        <DownloadList />
      </div>
    </div>
  </section>

  <section id="gallery" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">What it sees</h2>
        <p>Every capture keeps the temperature of each pixel, so you can measure again later. These are example scenes, rendered the way Studio exports them.</p>
      </div>
      <div class="gallery">
        {EXAMPLES.slice(0, 5).map((e, i) => (
          <figure class={i < 2 ? 'g-wide' : 'g-third'}>
            <img src={`/images/examples/${e.id}.jpg`} alt={`Example thermal image: ${e.title.toLowerCase()}, ${e.range}`} width={EXAMPLE_W} height={EXAMPLE_H} loading="lazy" />
            <figcaption><b>{e.title}</b><span>{e.note}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="after-track"><a class="btn btn-ghost" href="/thermal-images/">See all examples</a><span>Open them in Studio: each one has a .DAT file.</span></div>
    </div>
  </section>

  <section id="files" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">Every file is in the repository</h2>
        <p>Change the board, print a different shell or fork the firmware. GPL-3.0.</p>
      </div>
      <div class="files">
        <div class="file"><Icon name="chip" class="fic" /><h3>Board</h3><p>KiCad project, Gerbers, and BOM and placement files for JLCPCB, Seeed and PCBWay.</p><a href={`${SITE.repoUrl}/tree/master/hardware/pcb`}>hardware/pcb</a></div>
        <div class="file"><Icon name="box" class="fic" /><h3>Shell</h3><p>build123d source with STEP, STL and 3MF exports. Prints without supports.</p><a href={`${SITE.repoUrl}/tree/master/hardware/enclosure`}>hardware/enclosure</a></div>
        <div class="file"><Icon name="camera" class="fic" /><h3>Firmware</h3><p>C++17 for Teensy 4.1. Builds with arduino-cli.</p><a href={`${SITE.repoUrl}/tree/master/firmware`}>firmware</a></div>
        <div class="file"><Icon name="file" class="fic" /><h3>Studio</h3><p>Tauri and Rust with a React interface. Reads every .DAT capture.</p><a href={`${SITE.repoUrl}/tree/master/app`}>app</a></div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .hero { padding-block: 56px 64px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(40px, 5vw, 60px); line-height: 1.02; letter-spacing: -0.04em; font-weight: 700; }
  .hero h1 .hot { color: var(--hot); }
  .lead { margin: 20px 0 0; font-size: 18px; line-height: 1.55; color: var(--muted); max-width: 46ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .cta .btn :global(.ic) { display: inline-flex; }

  .hero-dl { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--border); display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 10px 14px; align-items: center; }
  .dl-label { font-size: 13px; color: var(--dim); font-weight: 500; }
  .dl-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .dl-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 30px; padding: 0 10px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--bg-2); color: var(--muted); font: 500 13px/1 var(--font-sans); text-decoration: none; transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease; }
  .dl-chip:hover { background: var(--surface-2); border-color: var(--border-strong); color: var(--text); }
  .dl-chip :global(.chip-ic), .dl-chip :global(.chip-ext) { display: inline-flex; flex: none; }
  .dl-chip :global(.chip-ic svg) { width: 14px; height: 14px; display: block; color: var(--dim); }
  .dl-chip :global(.chip-ext svg) { width: 13px; height: 13px; display: block; color: var(--dim); }
  .dl-chip:hover :global(.chip-ic svg), .dl-chip:hover :global(.chip-ext svg) { color: var(--text); }

  .hero-shot { margin: 0; position: relative; border-radius: var(--radius-lg); overflow: hidden; background: var(--cad); box-shadow: var(--shadow-window); border: 1px solid var(--border); }
  .hero-shot img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }

  .thumbs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }
  .thumb { display: flex; flex-direction: column; align-items: stretch; gap: 6px; padding: 0; border: 0; background: none; color: var(--dim); font: 500 12.5px/1.2 var(--font-sans); text-align: center; cursor: pointer; }
  .thumb:focus-visible { border-radius: var(--radius); }
  .thumb-img { display: block; width: 100%; aspect-ratio: 3 / 2; border-radius: var(--radius); overflow: hidden; background: var(--cad); border: 1.5px solid var(--border); opacity: 0.72; transition: opacity 140ms ease, border-color 140ms ease, box-shadow 140ms ease; }
  .thumb-img img { width: 100%; height: 100%; object-fit: cover; }
  .thumb:hover { color: var(--text); }
  .thumb:hover .thumb-img { opacity: 1; border-color: var(--border-strong); }
  .thumb[aria-selected='true'] { color: var(--text); }
  .thumb[aria-selected='true'] .thumb-img { opacity: 1; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .thumb-label { display: block; }

  .specs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--border); margin: 56px 0 0; }
  .spec { padding: 18px 20px 0 0; }
  .spec + .spec { padding-left: 20px; border-left: 1px solid var(--border); }
  .spec dt { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--dim); }
  .spec :global(.spec-ic) { display: inline-flex; flex: none; color: var(--muted); }
  .spec :global(.spec-ic svg) { width: 16px; height: 16px; display: block; }
  .spec dd { margin: 6px 0 0; font-size: 15px; font-weight: 500; color: var(--text); }

  .track-wrap { position: relative; }
  .track { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; list-style: none; margin: 0; padding: 0; }
  .track-rail { position: absolute; left: 22px; right: 22px; top: 21px; }
  .step { position: relative; display: flex; flex-direction: column; }
  .disc { position: relative; z-index: 1; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--bg); border: 1px solid var(--border-strong); color: var(--text); font-weight: 600; font-size: 15px; }
  .step h3 { margin-top: 18px; font-size: 18px; letter-spacing: -0.01em; }
  .step p { margin: 6px 0 16px; color: var(--muted); font-size: 15px; }
  .step figure { margin: auto 0 0; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--cad); aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .step figure img { width: 100%; height: 100%; object-fit: contain; }
  .step figure.dark { background: #0b0b0c; }
  .step figure.line { background: #ffffff; }
  .step figure.photo img { object-fit: cover; }
  .step figure.dark img { object-fit: cover; object-position: 40% center; }
  .after-track { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; color: var(--muted); font-size: 15px; }

  .dl { margin-top: 56px; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 40px; align-items: start; scroll-margin-top: 80px; }
  .dl h3 { font-size: 22px; letter-spacing: -0.02em; }
  .dl p { margin: 8px 0 0; color: var(--muted); font-size: 15px; }

  .gallery { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px 20px; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; border-radius: 10px; border: 1px solid var(--border); background: #0b0b0c; }
  .gallery figcaption { margin-top: 10px; font-size: 14px; color: var(--muted); }
  .gallery figcaption b { display: block; color: var(--text); font-weight: 600; font-size: 15px; }
  .g-wide { grid-column: span 6; }
  .g-third { grid-column: span 4; }

  .files { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--border); }
  .file { padding: 22px 22px 4px 0; }
  .file + .file { padding-left: 22px; border-left: 1px solid var(--border); }
  .file :global(.fic) { color: var(--dim); display: block; }
  .file :global(.fic svg) { width: 22px; height: 22px; display: block; }
  .file h3 { margin-top: 14px; font-size: 16px; }
  .file p { margin: 6px 0 12px; color: var(--muted); font-size: 14px; }
  .file a { font-size: 14px; font-weight: 500; text-decoration: none; }

  @media (prefers-reduced-motion: reduce) {
    .dl-chip, .thumb-img { transition: none; }
  }
  @media (max-width: 900px) {
    .dl-chip { min-height: 44px; padding: 0 14px; font-size: 14px; }
    .thumb { min-height: 44px; }
  }
  @media (max-width: 480px) {
    .hero-dl { grid-template-columns: 1fr; gap: 6px; }
  }
  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .specs { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 18px; }
    .spec:nth-child(4) { padding-left: 0; border-left: 0; }
    .track { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
    .track-rail { display: none; }
    .dl { grid-template-columns: 1fr; gap: 20px; }
    .files { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .file:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 600px) {
    .hero { padding-block: 36px 48px; }
    .specs { margin-top: 40px; }
    .thumbs { gap: 6px; }
    .thumb-label { font-size: 11.5px; }
    .specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spec, .spec + .spec { padding-left: 0; border-left: 0; padding-right: 12px; }
    .track { grid-template-columns: 1fr; }
    .g-wide, .g-third { grid-column: span 12; }
    .files { grid-template-columns: 1fr; }
    .file + .file { padding-left: 0; border-left: 0; border-top: 1px solid var(--border); }
    .cta .btn { width: 100%; }
          }
</style>
