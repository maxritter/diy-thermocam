---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { computeBomTotals, loadBomItems } from '../lib/bom';
import { SITE } from '../lib/site';

const bomItems = loadBomItems();
const v30 = computeBomTotals(bomItems, 'v3.0');
const v40 = computeBomTotals(bomItems, 'v4.0');

const featuredThermal = [
  { title: 'Microcontroller PCB', src: '/images/thermal/processor.jpg' },
  { title: 'German Ravioli', src: '/images/thermal/pasta_squares.png' },
  { title: 'Car Engine', src: '/images/thermal/car_engine.jpg' },
  { title: 'House Insulation', src: '/images/thermal/houses_2.jpg' },
  { title: 'Heater after Venting', src: '/images/thermal/heater_after.jpg' },
  { title: 'Soldering Iron', src: '/images/thermal/soldering_iron.jpg' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.tagline,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'DIY-Thermocam Open-Source Thermal Camera',
    description:
      'Open-source radiometric FLIR Lepton thermal camera on Teensy 4.1 with KiCad hardware, parametric enclosures, and a cross-platform desktop app.',
    image: `${SITE.url}/images/brand/hero-thermal-banner.png`,
    brand: { '@type': 'Brand', name: 'DIY-Thermocam' },
    url: `${SITE.url}/`,
    offers: {
      '@type': 'Offer',
      price: String(v30.requiredUsd),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: `${SITE.url}/docs/partlist/`,
    },
  },
];
---

<MarketingLayout
  title={SITE.name}
  description="Build an open-source radiometric FLIR Lepton thermal camera on Teensy 4.1. Open KiCad hardware, Firmware 4.0, and a cross-platform desktop app under GPL-3.0."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Open-source radiometric thermal camera</h1>
        <p class="lead">
          Build a handheld 160×120 infrared imager with FLIR Lepton 3.5, Teensy 4.1, open KiCad
          hardware, and a cross-platform desktop app under GPL-3.0.
        </p>
        <div class="cta-row">
          <a href="/building-instructions/" class="btn-primary">Build yours</a>
          <a href="/docs/partlist/" class="btn-secondary">Bill of Materials (~${Math.round(v40.requiredUsd)})</a>
          <a href="/docs/" class="inline-link">Read docs</a>
        </div>
        <dl class="spec-strip tabular">
          <div>
            <dt>Resolution</dt>
            <dd>160×120 LWIR</dd>
          </div>
          <div>
            <dt>Sensitivity</dt>
            <dd>&lt; 50 mK NETD</dd>
          </div>
          <div>
            <dt>Range</dt>
            <dd>-10 to +450 °C</dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>GPL-3.0</dd>
          </div>
        </dl>
      </div>

      <figure class="hero-media">
        <img
          src="/images/brand/hero-thermal-banner.png"
          alt="DIY-Thermocam V4 dual-angle studio view showing the front FLIR Lepton 3.5 lens and the rear 3.2-inch Ironbow thermal display"
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Two ways to build</h2>
        <p>
          Order a factory-assembled V4.0 board for screwdriver-only assembly, or hand-solder the
          proven V3.0 through-hole design.
        </p>
      </div>

      <div class="paths-grid">
        <article class="path-col">
          <div class="path-meta">
            <h3>V4.0 Zero-Solder</h3>
            <span class="status status-pending">Prototype-pending</span>
          </div>
          <p>
            Order a factory-populated PCBA and 3D-printed shell from JLCPCB, Seeed Studio Fusion,
            or PCBWay. Plug in Teensy 4.1, FLIR Lepton 3.5 or 3.1R, display, and a slim 505060 LiPo.
          </p>
          <ul class="detail-list">
            <li>USB-C with TI BQ24074 power-path charger and TPS61022 5 V boost</li>
            <li>Onboard slide switch, capture button, polarity protection, and 3.3 V RTC LDO</li>
            <li>~${v40.requiredUsd.toFixed(0)} full BOM incl. Lepton 3.5 (~${v40.withoutSensorUsd.toFixed(0)} excl. sensor)</li>
          </ul>
          <a href="/building-instructions/#option-a-diy-thermocam-v4-zero-solder-screwdriver-only-prototype-pending" class="text-link">
            V4 assembly guide &rarr;
          </a>
        </article>

        <article class="path-col">
          <div class="path-meta">
            <h3>V3.0 Classic</h3>
            <span class="status status-proven">Proven default</span>
          </div>
          <p>
            The verified hand-soldered baseline built by makers, schools, and labs. Uses a 2-layer
            through-hole PCB, Pololu U3V16F5 boost regulator, and 3 mm laser-cut acrylic shell.
          </p>
          <ul class="detail-list">
            <li>Proven Eagle files preserved at git tag <code>3.0.4</code></li>
            <li>45-step illustrated assembly manual with real bench photos</li>
            <li>~${v30.requiredUsd.toFixed(0)} full BOM incl. Lepton 3.5 (~${v30.withoutSensorUsd.toFixed(0)} excl. sensor)</li>
          </ul>
          <a href="/docs/partlist/" class="text-link">
            Compare V4.0 and V3.0 in the BOM &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-row">
        <div class="split-copy">
          <h2>Standalone touchscreen camera</h2>
          <p>
            Capture 14-bit radiometric <code>.DAT</code> images and time-lapse sequences with 4–6
            hours of battery life. Pick from 19 color palettes, hold manual temperature limits,
            and place up to 96 measurement spots on the 3.2-inch display.
          </p>
          <p>
            Open-source C++17 firmware compiles with <code>arduino-cli</code> and Teensy core 1.62.0.
            Verified on real hardware at 8.77 fps USB streaming and 0.26 ms command latency.
          </p>
          <div class="link-row">
            <a href="/device-features/" class="text-link">Specifications &rarr;</a>
            <a href="/docs/firmware/" class="text-link">Firmware guide &rarr;</a>
          </div>
        </div>
        <div class="split-media">
          <img
            src="/images/device/gui.png"
            alt="DIY-Thermocam 3.2-inch touchscreen showing live thermal view and on-device menus"
            loading="lazy"
          />
        </div>
      </div>

      <div class="split-row split-reverse">
        <div class="split-copy">
          <h2>Cross-platform Desktop Studio</h2>
          <p>
            Connect to macOS, Windows, or Linux over USB for live WebGL2 viewing, draggable range
            bars, and per-ROI emissivity correction. Export H.264 MP4, 16-bit Kelvin TIFF, CSV,
            and inspection reports with no FFmpeg install.
          </p>
          <p>
            Binary USB Protocol v2 adds direct microSD browsing at 9.20 MB/s without MTP drivers
            and built-in HalfKay firmware updates.
          </p>
          <div class="link-row">
            <a href="/software/" class="text-link">Desktop Studio &rarr;</a>
            <a href="/docs/protocol-v2/" class="text-link">USB Protocol v2 &rarr;</a>
          </div>
        </div>
        <div class="split-media">
          <img
            src="/images/software/thermal_analysis_sw_2.png"
            alt="Thermal analysis workspace displaying a radiometric frame with temperature scale"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head-row">
        <div>
          <h2>Captured with DIY-Thermocam</h2>
          <p>Radiometric frames from building inspections, PCB debugging, HVAC, and fieldwork.</p>
        </div>
        <a href="/thermal-images/" class="text-link">All 25 captures &rarr;</a>
      </div>

      <div class="thermal-grid">
        {featuredThermal.map((item) => (
          <a href="/thermal-images/" class="thermal-item">
            <img src={item.src} alt={item.title} loading="lazy" />
            <span>{item.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing-inner">
      <div>
        <h2>Everything in one open-source repository</h2>
        <p>
          Schematics, KiCad files, parametric CAD, firmware, desktop app, and manuals live together
          on GitHub under GPL-3.0.
        </p>
      </div>
      <div class="cta-row closing-actions">
        <a href="/docs/" class="btn-primary">Open documentation</a>
        <a href={SITE.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .container {
    max-width: var(--tc-container);
    margin: 0 auto;
    padding: 0 28px;
  }
  .hero {
    padding: 72px 0 80px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: center;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2.4rem, 4.2vw, 3.4rem);
    line-height: 1.06;
    font-weight: 650;
    letter-spacing: -0.036em;
  }
  .lead {
    margin: 20px 0 0;
    font-size: 1.08rem;
    line-height: 1.62;
    color: var(--tc-text-muted);
    max-width: 50ch;
  }
  .cta-row {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 0 18px;
    border-radius: 7px;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 140ms var(--tc-ease), border-color 140ms var(--tc-ease);
  }
  .btn-primary {
    background: var(--tc-thermal);
    color: var(--tc-text-on-thermal);
    border: 1px solid var(--tc-thermal);
  }
  .btn-primary:hover {
    background: var(--tc-thermal-hover);
    border-color: var(--tc-thermal-hover);
  }
  .btn-secondary {
    background: transparent;
    color: var(--tc-text);
    border: 1px solid var(--tc-border-strong);
  }
  .btn-secondary:hover {
    background: var(--tc-surface-2);
  }
  .inline-link {
    padding: 0 6px;
    font-size: 14.5px;
    font-weight: 550;
    color: var(--tc-text-muted);
    text-decoration: none;
  }
  .inline-link:hover {
    color: var(--tc-text);
    text-decoration: underline;
  }
  .spec-strip {
    margin: 40px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--tc-border);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .spec-strip dt {
    font-size: 12px;
    color: var(--tc-text-dim);
  }
  .spec-strip dd {
    margin: 3px 0 0;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tc-text);
    font-family: var(--tc-font-mono);
  }
  .hero-media {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--tc-border);
    background: var(--tc-bg-sunken);
  }
  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
  }
  .section {
    padding: 80px 0;
    border-top: 1px solid var(--tc-border);
  }
  .section-head {
    max-width: 60ch;
    margin-bottom: 40px;
  }
  .section-head-row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 650;
  }
  .section-head p {
    margin: 10px 0 0;
    color: var(--tc-text-muted);
    font-size: 1rem;
  }
  .paths-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
  }
  .path-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--tc-border);
  }
  .path-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .path-col h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
  }
  .status {
    font-family: var(--tc-font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .status-pending {
    color: var(--tc-amber);
  }
  .status-proven {
    color: var(--tc-pass);
  }
  .path-col p {
    margin: 0;
    font-size: 15px;
    color: var(--tc-text-muted);
    max-width: 54ch;
  }
  .detail-list {
    margin: 2px 0 4px;
    padding-left: 18px;
    font-size: 14.5px;
    color: var(--tc-text-muted);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .detail-list code,
  .split-copy code {
    font-family: var(--tc-font-mono);
    font-size: 0.88em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--tc-surface-2);
    color: var(--tc-text);
  }
  .text-link {
    margin-top: auto;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--tc-thermal);
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  .split-row {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: center;
  }
  .split-row + .split-row {
    margin-top: 84px;
    padding-top: 84px;
    border-top: 1px solid var(--tc-border);
  }
  .split-reverse .split-media {
    order: -1;
  }
  .split-copy h2 {
    margin: 0 0 14px;
    font-size: clamp(1.5rem, 2.4vw, 1.95rem);
    font-weight: 650;
  }
  .split-copy p {
    margin: 0 0 14px;
    color: var(--tc-text-muted);
    max-width: 54ch;
  }
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 20px;
  }
  .split-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    border: 1px solid var(--tc-border);
  }
  .thermal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .thermal-item {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .thermal-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 8px;
    border: 1px solid var(--tc-border);
  }
  .thermal-item span {
    font-size: 14px;
    font-weight: 500;
    color: var(--tc-text-muted);
  }
  .thermal-item:hover span {
    color: var(--tc-text);
  }
  .closing-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .closing h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    font-weight: 650;
  }
  .closing p {
    margin: 10px 0 0;
    color: var(--tc-text-muted);
    max-width: 56ch;
  }
  .closing-actions {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .hero {
      padding: 48px 0 56px;
    }
    .hero-grid,
    .paths-grid,
    .split-row,
    .thermal-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .split-reverse .split-media {
      order: 0;
    }
    .spec-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .section {
      padding: 56px 0;
    }
  }
</style>
