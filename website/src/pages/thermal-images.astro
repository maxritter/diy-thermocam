---
import Icon from '../components/Icon.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { EXAMPLE_H, EXAMPLE_W, EXAMPLES } from '../data/examples';
import { buildBreadcrumbs } from '../lib/site';

const jsonLd = buildBreadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Gallery', path: '/thermal-images/' },
]);
---

<MarketingLayout
  title="Gallery"
  description="What DIY-Thermocam sees: heat loss on a house, a board under load, a breaker panel, a radiator and more, rendered the way Studio exports them, each with a .DAT file to open in Studio."
  canonicalPath="/thermal-images/"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="wrap">
      <h1>What it sees</h1>
      <p>Each picture keeps the temperature of every pixel. Download the .DAT next to it and open it in Studio to measure, change the palette or export it again.</p>
      <div class="note ex-note"><Icon name="info" /><span>These are example scenes, rendered at the Lepton's 160 × 120 the way Studio exports them. Real V4 captures will replace them once V4 has been tested on a camera.</span></div>
    </div>
  </section>

  <section class="gal">
    <div class="wrap grid">
      {EXAMPLES.map((e) => (
        <figure>
          <a href={`/images/examples/${e.id}.jpg`}><img src={`/images/examples/${e.id}.jpg`} alt={`Example thermal image: ${e.title.toLowerCase()}, ${e.range}, ${e.palette} palette`} width={EXAMPLE_W} height={EXAMPLE_H} loading="lazy" /></a>
          <figcaption>
            <div class="t"><b>{e.title}</b><span class="meta">{e.palette} · {e.range}</span></div>
            <p>{e.note}</p>
            <a class="dat" href={`/examples/${e.dat}`} download><Icon name="download" />{e.dat}</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</MarketingLayout>

<style>
  .ex-note { margin-top: 24px; max-width: 760px; }
  .ex-note :global(.ic svg) { width: 16px; height: 16px; display: block; }
  .gal { padding-bottom: 96px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; }
  figure { margin: 0; }
  figure > a { display: block; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: #0b0b0c; }
  figcaption { margin-top: 12px; }
  .t { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
  .t b { font-size: 16px; font-weight: 600; }
  .meta { font-size: 13px; color: var(--dim); font-variant-numeric: tabular-nums; }
  figcaption p { margin: 4px 0 8px; color: var(--muted); font-size: 14.5px; }
  .dat { display: inline-flex; align-items: center; gap: 6px; font: 500 13px var(--font-mono); text-decoration: none; }
  .dat :global(svg) { width: 14px; height: 14px; display: block; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .gal { padding-bottom: 64px; } }
</style>
