---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { marked } from 'marked';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildBreadcrumbs, SITE } from '../lib/site';

const rawMd = readFileSync(resolve(process.cwd(), '../docs/building-instructions.md'), 'utf8');
const withoutH1 = rawMd.replace(/^\s*#\s+[^\n]+\n+/, '');

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const renderer = new marked.Renderer();
renderer.heading = ({ tokens, depth }) => {
  const html = marked.Parser.parseInline(tokens);
  const plain = html.replace(/<[^>]+>/g, '');
  const id = slugify(plain);
  return `<h${depth} id="${id}">${html}</h${depth}>`;
};

const guideHtml = await marked.parse(withoutH1, { renderer });

const jsonLd = [
  buildBreadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Building Instructions', path: '/building-instructions/' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Build DIY-Thermocam V4 or V3.0 Thermal Camera',
    description:
      'Step-by-step assembly guide for the zero-solder V4 PCBA or the proven 45-step V3.0 through-hole camera.',
    image: `${SITE.url}/images/build-v4/v4-step-1-unbox-pcba.png`,
    supply: [
      { '@type': 'HowToSupply', name: 'FLIR Lepton 3.5 Thermal Camera Module' },
      { '@type': 'HowToSupply', name: 'Teensy 4.1 Development Board' },
      { '@type': 'HowToSupply', name: 'DIY-Thermocam PCB (V4 PCBA or V3.0 THT)' },
      { '@type': 'HowToSupply', name: '3.2-inch ILI9341 TFT Touch Display (BuyDisplay ER-TFTM032-3)' },
      { '@type': 'HowToSupply', name: 'Protected 3.7 V 2000 mAh LiPo Battery' },
    ],
    tool: [
      { '@type': 'HowToTool', name: 'Phillips screwdriver (V4 zero-solder build)' },
      { '@type': 'HowToTool', name: 'Soldering iron, flush cutters, and multimeter (V3.0 build)' },
    ],
  },
];
---

<MarketingLayout
  title="Building Instructions"
  description="Assemble DIY-Thermocam V4 with a Phillips screwdriver or follow the proven 45-step V3.0 soldering guide."
  canonicalPath="/building-instructions/"
  jsonLd={jsonLd}
>
  <section class="page-wrap">
    <header class="page-head">
      <h1>Building instructions</h1>

      <nav class="jump-bar" aria-label="Build tracks">
        <a href="#option-a-diy-thermocam-v4-zero-solder-screwdriver-only-prototype-pending" class="jump-primary">
          V4 Zero-Solder (3 steps)
        </a>
        <a href="#option-b-classic-diy-thermocam-v3-0-45-step-through-hole-guide-verified-baseline" class="jump-secondary">
          Classic V3.0 (45 steps)
        </a>
        <a href="/docs/partlist/" class="jump-secondary">
          Interactive BOM
        </a>
      </nav>
    </header>

    <article class="tc-prose guide-content" set:html={guideHtml} />
  </section>
</MarketingLayout>

<style>
  .page-wrap {
    max-width: var(--tc-container);
    margin: 0 auto;
    padding: 56px 28px 24px;
  }
  .page-head {
    max-width: 68ch;
    margin-bottom: 40px;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 650;
  }
  .page-head p {
    margin: 12px 0 0;
    font-size: 1.05rem;
    color: var(--tc-text-muted);
  }
  .jump-bar {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .jump-primary,
  .jump-secondary {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 16px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .jump-primary {
    background: var(--tc-thermal);
    color: var(--tc-text-on-thermal);
  }
  .jump-secondary {
    border: 1px solid var(--tc-border-strong);
    background: transparent;
    color: var(--tc-text);
  }
  .jump-secondary:hover {
    background: var(--tc-surface-2);
  }
  .guide-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0 2rem;
    font-size: 14px;
    border: 1px solid var(--tc-border);
  }
  .guide-content :global(th) {
    text-align: left;
    padding: 10px 12px;
    background: var(--tc-bg-sunken);
    color: var(--tc-text);
    border-bottom: 1px solid var(--tc-border);
  }
  .guide-content :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--tc-border);
    vertical-align: top;
  }
  .guide-content :global(hr) {
    display: none;
  }
</style>
