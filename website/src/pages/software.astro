---
import DownloadCards from '../components/DownloadCards.astro';
import AppShot from '../components/AppShot.astro';
import Icon from '../components/Icon.astro';
import { EXAMPLES } from '../data/examples';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildBreadcrumbs, SITE } from '../lib/site';

const features = [
  {
    id: 'live',
    icon: 'palette' as const,
    title: 'See it live',
    body: 'Plug in the camera and Studio finds it. The live image runs at the Lepton’s full 8.7 frames a second, with a fixed or automatic temperature range.',
    points: ['The camera’s 19 palettes, plus Inferno, Viridis, Magma, Plasma, Turbo and your own', 'Hottest, coldest and centre point marked as you move', 'Every tool one click away: no modes to switch'],
    shot: 'palettes' as const, alt: 'Studio Live view of a house front in winter in Ironblack, with the palette grid, colour scale and image options beside it',
  },
  {
    id: 'measure',
    icon: 'ruler' as const,
    title: 'Measure anything',
    body: 'Place points and areas on the image and read their temperatures live, or on a saved capture.',
    points: ['Spots of 1 or 3 × 3 pixels, boxes, circles and polygons', 'Line profiles and the difference between two points', 'Emissivity per area, reflected temperature, and presets for skin, circuit boards, brick and metals'],
    shot: 'measure' as const, alt: 'Studio measuring a breaker panel: a box on the hot breaker, a line across the row, and charts of the readings over time and along the line',
  },
  {
    id: 'watch',
    icon: 'thermometer' as const,
    title: 'Find what stands out',
    body: 'Mark every pixel above or below a temperature, and let Studio watch a reading over time.',
    points: ['Isotherms you drag to the temperature you care about', 'A live histogram of the whole frame', 'A plot over time, and alarms that start a capture or a recording when a value crosses a limit'],
    shot: 'live' as const, alt: 'Studio Live view of a circuit board under load: a box on the hot chip, a spot on the regulator, and the histogram beside the colour scale',
  },
  {
    id: 'export',
    icon: 'share' as const,
    title: 'Export and share',
    body: 'Save what you see in the format the next person needs. Nothing extra to install.',
    points: ['PNG or JPEG with a scale bar, GIF, and MP4 video', 'CSV of every temperature, 16-bit TIFF in kelvin, .DAT sequences and time-lapse', 'A report in HTML or Markdown with your measurements'],
    img: '/images/examples/pcb.jpg', w: 1470, h: 1024, alt: 'An export of a circuit board under load with the hottest and coldest points and a scale bar',
  },
];

const editor = EXAMPLES.slice(0, 4);

const jsonLd = [
  buildBreadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Studio', path: '/software/' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DIY-Thermocam Studio',
    operatingSystem: 'macOS, Windows, Linux',
    applicationCategory: 'MultimediaApplication',
    license: 'https://polyformproject.org/licenses/noncommercial/1.0.0/',
    screenshot: `${SITE.url}/images/studio/studio-measure.png`,
    featureList: features.map((f) => f.title),
    url: `${SITE.url}/software/`,
    downloadUrl: SITE.releasesUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<MarketingLayout
  title="Studio"
  description="DIY-Thermocam Studio for macOS, Windows and Linux: live view, measuring with spots, boxes and line profiles, isotherms, exports to PNG, MP4, CSV and TIFF, the camera's SD card, and firmware updates."
  canonicalPath="/software/"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="wrap">
      <h1>Studio, the desktop app</h1>
      <p>See the camera’s image live on your computer, measure any point, and keep every pixel’s temperature for later. Studio also installs the camera’s firmware.</p>
      <div class="cta">
        <a class="btn btn-primary" data-os-download href="#download"><span>Download Studio</span></a>
        <a class="btn btn-ghost" href="/docs/desktop-app/">Read the Studio guide</a>
      </div>
      <ul class="facts">
        <li><span class="os" aria-hidden="true"><Icon name="apple" /><Icon name="windows" /><Icon name="linux" /></span>macOS, Windows and Linux</li>
        <li>Works with V3 and V4 cameras</li>
        <li>Free for non-commercial use</li>
      </ul>
      <nav class="jump" aria-label="On this page">
        {features.map((f) => <a href={`#${f.id}`}>{f.title}</a>)}
        <a href="#editor">Open saved captures</a>
        <a href="#camera">SD card and firmware</a>
      </nav>
    </div>
  </section>

  {features.map((f, i) => (
    <section id={f.id} class:list={['section', 'feat', { flip: i % 2 === 1 }]}>
      <div class="wrap feat-grid">
        <div class="txt">
          <Icon name={f.icon} class="fic" />
          <h2 class="big">{f.title}</h2>
          <p>{f.body}</p>
          <ul class="points">{f.points.map((p) => <li>{p}</li>)}</ul>
        </div>
        {f.shot ? <AppShot name={f.shot} alt={f.alt} /> : <figure><img src={f.img} alt={f.alt} width={f.w} height={f.h} loading="lazy" /></figure>}
      </div>
    </section>
  ))}

  <section id="editor" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">Open saved captures</h2>
        <p>Studio opens the .DAT files any DIY-Thermocam saves. Change the palette, measure again and export. Your notes and areas go into a .thermo.json file next to the capture, so the .DAT stays readable on the camera.</p>
      </div>
      <div class="shots">
        <AppShot name="library" alt="Studio’s Captures library in grid view with eight thermal pictures, each showing its hottest temperature" />
        <AppShot name="editor" alt="A saved capture of a solar panel opened in Studio in Rainbow, a box on the hot cell and its readings in the Measure tab" />
      </div>
      <div class="try">
        <div><b>Try it without a camera</b><span>Download an example and open it in Studio’s editor.</span></div>
        <div class="dats">
          {editor.map((e) => (
            <a href={`/examples/${e.dat}`} download><Icon name="download" />{e.dat}</a>
          ))}
          <a href="/thermal-images/">All examples</a>
        </div>
      </div>
    </div>
  </section>

  <section id="camera" class="section">
    <div class="wrap two">
      <div>
        <Icon name="sd" class="big-ic" />
        <h3>The camera’s SD card</h3>
        <p>Browse, preview, download and delete captures over the same USB cable, at about 9 MB/s. No card reader, no restart.</p>
      </div>
      <div>
        <Icon name="chip" class="big-ic" />
        <h3>Firmware updates</h3>
        <p>Choose the firmware file from the <a href={SITE.firmwareUrl}>latest release</a>. Studio checks it, installs it over USB and restarts the camera. You don’t need Teensy Loader.</p>
      </div>
    </div>
  </section>

  <section id="download" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="big">Download</h2>
        <p>Studio and the camera firmware are free for non-commercial use. V3 cameras run them today. V4 is experimental and not yet tested on a real camera.</p>
      </div>
      <DownloadCards />
      <p class="dl-note">On Linux, install PJRC's <a href="https://www.pjrc.com/teensy/00-teensy.rules">udev rules</a> once for USB access. · <a href={SITE.releasesUrl}>All releases and checksums</a></p>
    </div>
  </section>

  <section class="section dev">
    <div class="wrap">
      <p>Writing your own tools? Read the <a href="/docs/protocol-v2/">USB protocol</a> and the <a href="/docs/raw-data/">.DAT file format</a>, or start from <a href={`${SITE.repoUrl}/tree/master/app`}>Studio's source</a> (Tauri, Rust and React).</p>
    </div>
  </section>
</MarketingLayout>

<style>
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-bottom: 28px; }
  @media (max-width: 760px) { .shots { grid-template-columns: 1fr; } }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 18px 0 0; padding: 0; color: var(--muted); font-size: 14px; }
  .facts li { display: inline-flex; align-items: center; gap: 10px; }
  .facts .os { display: inline-flex; gap: 8px; color: var(--dim); }
  .facts .os :global(svg) { width: 16px; height: 16px; display: block; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .jump a { font-size: 13.5px; text-decoration: none; color: var(--muted); padding: 6px 12px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .jump a:hover { color: var(--text); border-color: var(--border-strong); }

  .feat-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 56px; align-items: center; }
  .flip .feat-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  .flip .txt { order: 2; }
  .txt :global(.fic) { width: 44px; height: 44px; display: grid; place-items: center; margin-bottom: 18px; border-radius: var(--radius-lg); border: 1px solid var(--border); background: var(--surface-2); color: var(--text); }
  .txt :global(.fic svg) { width: 22px; height: 22px; display: block; }
  .txt p { margin: 14px 0 0; color: var(--muted); font-size: 17px; max-width: 46ch; }
  .points { margin: 20px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .points li { position: relative; padding-left: 20px; font-size: 15px; }
  .points li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 3px; border-radius: 2px; background: var(--ironbow); }
  .feat figure { margin: 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: #0b0b0c; box-shadow: var(--shadow-window); }

  .try { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-2); }
  .try b { display: block; font-size: 16px; }
  .try span { color: var(--muted); font-size: 14.5px; }
  .dats { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
  .dats a { display: inline-flex; align-items: center; gap: 6px; font: 500 13.5px var(--font-mono); text-decoration: none; }
  .dats a:last-child { font-family: var(--font-sans); }
  .dats :global(svg) { width: 14px; height: 14px; display: block; }

  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .two > div { padding: 24px 32px 0 0; border-top: 1px solid var(--border); }
  .two > div + div { padding-left: 32px; border-left: 1px solid var(--border); }
  .two :global(.big-ic svg) { width: 24px; height: 24px; display: block; color: var(--dim); }
  .two h3 { margin-top: 14px; font-size: 20px; letter-spacing: -0.01em; }
  .two p { margin: 8px 0 0; color: var(--muted); font-size: 15.5px; max-width: 48ch; }

  .dl-note { margin: 18px 0 0; color: var(--muted); font-size: 14px; }
  .dev p { margin: 0; color: var(--muted); font-size: 16px; }
  .dev { padding-block: 48px 64px; }

  @media (max-width: 1000px) {
    .feat-grid { grid-template-columns: 1fr; gap: 28px; }
    .flip .feat-grid { grid-template-columns: 1fr; }
    .flip .txt { order: 0; }
  }
  @media (max-width: 700px) {
    .two { grid-template-columns: 1fr; }
    .two > div + div { padding-left: 0; border-left: 0; margin-top: 24px; }
    .cta .btn { width: 100%; }
  }
</style>
