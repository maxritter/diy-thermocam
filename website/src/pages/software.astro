---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildBreadcrumbs, SITE } from '../lib/site';

const appModules = [
  {
    title: 'Live WebGL2 view',
    body: 'Auto-detects cameras over USB Protocol v2 at 8.77 fps and 0.26 ms command latency. Supports all 19 firmware palettes plus Inferno, Viridis, Magma, Plasma, and custom LUTs.',
  },
  {
    title: 'Standard and Pro modes',
    body: 'Use Standard mode for quick snapshots and range control. Switch to Pro mode for spot meters, Box/Circle/Polygon ROIs, Line Profiles, isotherms, Time Plotter alarms, and per-ROI emissivity.',
  },
  {
    title: 'Built-in exports',
    body: 'Export H.264 MP4, animated GIF, PNG/JPEG with scale bars, CSV, 16-bit Kelvin TIFF, lossless .DAT sequences, and HTML/PDF/Markdown reports with no FFmpeg install.',
  },
  {
    title: 'Direct SD browser and updater',
    body: 'Browse and download microSD captures at 9.20 MB/s without MTP drivers. Flash verified Teensy 4.1 firmware releases over built-in HalfKay HID.',
  },
];

const legacyTools = [
  {
    title: 'ThermoVision by Joe-C',
    platform: 'Windows · archived at tag 3.0.4',
    image: '/images/software/thermal_analysis_sw_1.png',
    desc: 'Third-party Windows radiometric viewer for inspecting and converting DIY-Thermocam .DAT files.',
    href: 'https://github.com/maxritter/diy-thermocam/tree/3.0.4/software/thermal_analysis_software',
    extraHref: 'http://joe-c.de/pages/projekte/thermovision.php',
    extraLabel: 'Author site',
  },
  {
    title: 'Thermal Live Viewer',
    platform: 'Python · legacy v1 serial',
    image: '/images/software/thermal_live_viewer.png',
    desc: 'Standalone viewer for capturing frames and video over the legacy v1 USB serial protocol.',
    href: 'https://github.com/maxritter/diy-thermocam/tree/3.0.4/software/thermal_live_viewer',
  },
  {
    title: 'Thermal Data Viewer',
    platform: 'Windows · archived at tag 3.0.4',
    image: '/images/software/thermal_data_viewer.png',
    desc: 'Batch converter for folders of V1/V2/V3 .DAT captures to JPG, BMP, PNG, or AVI.',
    href: 'https://github.com/maxritter/diy-thermocam/tree/3.0.4/software/thermal_data_viewer',
  },
  {
    title: 'Video Converter',
    platform: 'Windows · archived at tag 3.0.4',
    desc: 'Combines saved microSD frame sequences into standard video files.',
    href: 'https://github.com/maxritter/diy-thermocam/tree/3.0.4/software/video_converter',
  },
];

const jsonLd = [
  buildBreadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Software', path: '/software/' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DIY-Thermocam Desktop Studio',
    operatingSystem: 'macOS, Windows, Linux',
    applicationCategory: 'UtilitiesApplication',
    license: 'https://www.gnu.org/licenses/gpl-3.0.html',
    url: `${SITE.url}/software/`,
    downloadUrl: SITE.releasesUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<MarketingLayout
  title="Desktop Studio & Software"
  description="Cross-platform Tauri v2 Desktop Studio for macOS, Windows, and Linux, plus archived V3.0 tools."
  canonicalPath="/software/"
  jsonLd={jsonLd}
>
  <section class="page-wrap">
    <header class="page-head">
      <h1>Desktop Studio and software</h1>
      <p>
        One open-source app for live streaming, radiometric .DAT analysis, video export, microSD
        browsing, and firmware updates on macOS, Windows, and Linux.
      </p>
      <div class="cta-row">
        <a href={SITE.releasesUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Download from GitHub Releases
        </a>
        <a href="/docs/desktop-app/" class="btn-secondary">Desktop Studio docs</a>
        <a href="/docs/protocol-v2/" class="btn-secondary">USB Protocol v2</a>
      </div>
    </header>

    <div class="app-grid">
      {appModules.map((mod) => (
        <article class="app-item">
          <h2>{mod.title}</h2>
          <p>{mod.body}</p>
        </article>
      ))}
    </div>

    <section class="legacy-section">
      <h2>Legacy V3.0 tools</h2>
      <p class="legacy-lead">
        Original Windows and Python tools stay archived at git tag <code>3.0.4</code>. Every
        <code>.DAT</code> file remains compatible across legacy tools and Desktop Studio.
      </p>

      <div class="legacy-grid">
        {legacyTools.map((tool) => (
          <article class="legacy-item">
            {tool.image && <img src={tool.image} alt={tool.title} loading="lazy" />}
            <div class="legacy-body">
              <div class="legacy-top">
                <h3>{tool.title}</h3>
                <span class="meta">{tool.platform}</span>
              </div>
              <p>{tool.desc}</p>
              <div class="legacy-links">
                <a href={tool.href} target="_blank" rel="noopener noreferrer">View archive &rarr;</a>
                {tool.extraHref && (
                  <a href={tool.extraHref} target="_blank" rel="noopener noreferrer">{tool.extraLabel} &rarr;</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>
</MarketingLayout>

<style>
  .page-wrap {
    max-width: var(--tc-container);
    margin: 0 auto;
    padding: 56px 28px 24px;
  }
  .page-head {
    max-width: 66ch;
    margin-bottom: 48px;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 650;
  }
  .page-head p {
    margin: 12px 0 0;
    font-size: 1.05rem;
    color: var(--tc-text-muted);
  }
  .cta-row {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--tc-thermal);
    color: var(--tc-text-on-thermal);
  }
  .btn-secondary {
    border: 1px solid var(--tc-border-strong);
    background: transparent;
    color: var(--tc-text);
  }
  .btn-secondary:hover {
    background: var(--tc-surface-2);
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 48px;
    margin-bottom: 64px;
  }
  .app-item {
    padding-top: 20px;
    border-top: 1px solid var(--tc-border);
  }
  .app-item h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 650;
  }
  .app-item p {
    margin: 0;
    font-size: 14.5px;
    color: var(--tc-text-muted);
    max-width: 52ch;
  }
  .legacy-section {
    padding-top: 48px;
    border-top: 1px solid var(--tc-border);
  }
  .legacy-section h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 650;
  }
  .legacy-lead {
    margin: 8px 0 28px;
    color: var(--tc-text-muted);
    max-width: 64ch;
  }
  .legacy-lead code {
    font-family: var(--tc-font-mono);
    font-size: 0.88em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--tc-surface-2);
    color: var(--tc-text);
  }
  .legacy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px;
  }
  .legacy-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .legacy-item img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--tc-border);
    border-radius: 8px;
    display: block;
  }
  .legacy-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .legacy-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .legacy-body h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
  }
  .meta {
    font-family: var(--tc-font-mono);
    font-size: 12px;
    color: var(--tc-text-dim);
  }
  .legacy-body p {
    margin: 0;
    font-size: 14px;
    color: var(--tc-text-muted);
  }
  .legacy-links {
    margin-top: auto;
    padding-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tc-thermal);
  }
  .legacy-links a {
    text-decoration: none;
  }
  .legacy-links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 820px) {
    .app-grid,
    .legacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
